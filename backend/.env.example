# Use the Supabase project URL, not its Dashboard URL. A trailing /rest/v1 is
# also accepted. In Render or Vercel, add these as private environment values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=YOUR_SERVER_SIDE_SECRET_KEY
# Legacy alternative accepted by the backend:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Optional. Defaults to 8000.
PORT=8000

# Required only by the protected Vercel scheduled forecast refresh.
CRON_SECRET=REPLACE_WITH_A_LONG_RANDOM_VALUE
