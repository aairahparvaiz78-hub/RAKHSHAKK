# Optional cloud storage. If these values are absent, Rakhshak uses local SQLite.
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_secret_key_here
# Legacy alternative accepted by the backend:
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY

# Optional. Defaults to 8000.
PORT=8000
